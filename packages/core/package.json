{
  "name": "@anweba/glugent-core",
  "version": "0.4.0",
  "description": "The Glugent library: load a project, render Markdown sections and build targets.",
  "keywords": [
    "glugent",
    "markdown",
    "templates",
    "ai-agents",
    "prompts",
    "agent-instructions"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anweba/glugent.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/anweba/glugent#readme",
  "bugs": {
    "url": "https://github.com/anweba/glugent/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/test"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p .",
    "test": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "fast-glob": "^3.3.2",
    "yaml": "^2.5.0"
  }
}
