{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "glugent.injection",
  "injectionSelector": "L:source.glugent -markup.raw.glugent",
  "patterns": [
    {
      "include": "#raw"
    },
    {
      "include": "#literal-brace"
    },
    {
      "include": "#ref-block"
    },
    {
      "include": "#slot-block"
    },
    {
      "include": "#slot"
    },
    {
      "include": "#ref"
    },
    {
      "include": "#if-open"
    },
    {
      "include": "#if-else"
    },
    {
      "include": "#if-close"
    },
    {
      "include": "#optional-default"
    },
    {
      "include": "#optional"
    },
    {
      "include": "#required"
    }
  ],
  "repository": {
    "raw": {
      "begin": "\\{!",
      "end": "!\\}",
      "name": "meta.template.raw.glugent",
      "contentName": "markup.raw.glugent",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.raw.begin.glugent"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.raw.end.glugent"
        }
      }
    },
    "literal-brace": {
      "match": "\\{\\{|\\}\\}",
      "name": "meta.literal-brace.glugent"
    },
    "ref-block": {
      "match": "(\\{)\\s*(REF(?:-OVERRIDE)?)\\s+(BEGIN|END)(?:\\s+([\\w.\\-/]+))?(?:\\s*(\\|)\\s*((?:[A-Za-z_][\\w.]*\\s*=\\s*(?:\"(?:[^\"\\\\]|\\\\.)*\"|true|false|-?\\d+(?:\\.\\d+)?)\\s*)+))?\\s*(\\})",
      "name": "meta.template.ref.glugent",
      "captures": {
        "1": {
          "name": "punctuation.definition.template-expression.begin.glugent"
        },
        "2": {
          "name": "keyword.other.ref.glugent"
        },
        "3": {
          "name": "keyword.control.block.glugent"
        },
        "4": {
          "name": "entity.name.section.glugent"
        },
        "5": {
          "name": "keyword.operator.ref-props.glugent"
        },
        "6": {
          "name": "meta.template.ref-props.glugent",
          "patterns": [
            {
              "match": "([A-Za-z_][\\w.]*)\\s*(=)",
              "captures": {
                "1": {
                  "name": "variable.parameter.glugent"
                },
                "2": {
                  "name": "keyword.operator.assignment.glugent"
                }
              }
            },
            {
              "match": "\"(?:[^\"\\\\]|\\\\.)*\"",
              "name": "string.quoted.double.glugent"
            },
            {
              "match": "\\b(?:true|false|-?\\d+(?:\\.\\d+)?)\\b",
              "name": "constant.language.glugent"
            }
          ]
        },
        "7": {
          "name": "punctuation.definition.template-expression.end.glugent"
        }
      }
    },
    "slot-block": {
      "match": "(\\{)\\s*(SLOT(?:-INHERIT)?)\\s+(BEGIN|END)(?:\\s+([A-Za-z_][\\w.]*))?\\s*(\\})",
      "name": "meta.template.slot-fill.glugent",
      "captures": {
        "1": {
          "name": "punctuation.definition.template-expression.begin.glugent"
        },
        "2": {
          "name": "keyword.other.slot.glugent"
        },
        "3": {
          "name": "keyword.control.block.glugent"
        },
        "4": {
          "name": "entity.name.tag.slot.glugent"
        },
        "5": {
          "name": "punctuation.definition.template-expression.end.glugent"
        }
      }
    },
    "slot": {
      "match": "(\\{-?)\\s*(#)([A-Za-z_][\\w.]*)?\\s*(\\?)?\\s*(-?\\})",
      "name": "meta.template.slot.glugent",
      "captures": {
        "1": {
          "name": "punctuation.definition.template-expression.begin.glugent"
        },
        "2": {
          "name": "keyword.other.slot.glugent"
        },
        "3": {
          "name": "entity.name.tag.slot.glugent"
        },
        "4": {
          "name": "keyword.operator.optional.glugent"
        },
        "5": {
          "name": "punctuation.definition.template-expression.end.glugent"
        }
      }
    },
    "ref": {
      "match": "(\\{)\\s*(REF(?:-OVERRIDE)?)\\s+([\\w.\\-/]+)(?:\\s*(\\|)\\s*((?:[A-Za-z_][\\w.]*\\s*=\\s*(?:\"(?:[^\"\\\\]|\\\\.)*\"|true|false|-?\\d+(?:\\.\\d+)?)\\s*)+))?\\s*(\\})",
      "name": "meta.template.ref.glugent",
      "captures": {
        "1": {
          "name": "punctuation.definition.template-expression.begin.glugent"
        },
        "2": {
          "name": "keyword.other.ref.glugent"
        },
        "3": {
          "name": "entity.name.section.glugent"
        },
        "4": {
          "name": "keyword.operator.ref-props.glugent"
        },
        "5": {
          "name": "meta.template.ref-props.glugent",
          "patterns": [
            {
              "match": "([A-Za-z_][\\w.]*)\\s*(=)",
              "captures": {
                "1": {
                  "name": "variable.parameter.glugent"
                },
                "2": {
                  "name": "keyword.operator.assignment.glugent"
                }
              }
            },
            {
              "match": "\"(?:[^\"\\\\]|\\\\.)*\"",
              "name": "string.quoted.double.glugent"
            },
            {
              "match": "\\b(?:true|false|-?\\d+(?:\\.\\d+)?)\\b",
              "name": "constant.language.glugent"
            }
          ]
        },
        "6": {
          "name": "punctuation.definition.template-expression.end.glugent"
        }
      }
    },
    "if-open": {
      "match": "(\\{-?)\\s*(if)\\s+([\\w.()&|!\\s]+?)\\s*(\\{)",
      "name": "meta.template.if.glugent",
      "captures": {
        "1": {
          "name": "punctuation.definition.template-expression.begin.glugent"
        },
        "2": {
          "name": "keyword.control.conditional.glugent"
        },
        "3": {
          "name": "variable.other.constant.glugent"
        },
        "4": {
          "name": "punctuation.section.block.begin.glugent"
        }
      }
    },
    "if-else": {
      "match": "(\\})\\s*(else)(?:\\s+(if)\\s+([\\w.()&|!\\s]+?))?\\s*(\\{)",
      "name": "meta.template.if.glugent",
      "captures": {
        "1": {
          "name": "punctuation.section.block.end.glugent"
        },
        "2": {
          "name": "keyword.control.conditional.glugent"
        },
        "3": {
          "name": "keyword.control.conditional.glugent"
        },
        "4": {
          "name": "variable.other.constant.glugent"
        },
        "5": {
          "name": "punctuation.section.block.begin.glugent"
        }
      }
    },
    "if-close": {
      "match": "(\\})\\s+(-?\\})",
      "name": "meta.template.if.glugent",
      "captures": {
        "1": {
          "name": "punctuation.section.block.end.glugent"
        },
        "2": {
          "name": "punctuation.definition.template-expression.end.glugent"
        }
      }
    },
    "required": {
      "match": "(\\{)\\s*([A-Za-z_][\\w.]*)\\s*(\\})",
      "name": "meta.template.required.glugent",
      "captures": {
        "1": {
          "name": "punctuation.definition.template-expression.begin.glugent"
        },
        "2": {
          "name": "variable.other.constant.glugent"
        },
        "3": {
          "name": "punctuation.definition.template-expression.end.glugent"
        }
      }
    },
    "optional": {
      "match": "(\\{)\\s*(-)?([A-Za-z_][\\w.]*)\\s*(\\?)\\s*(-)?\\s*(\\})",
      "name": "meta.template.optional.glugent",
      "captures": {
        "1": {
          "name": "punctuation.definition.template-expression.begin.glugent"
        },
        "2": {
          "name": "keyword.operator.optional.glugent"
        },
        "3": {
          "name": "variable.other.constant.optional.glugent"
        },
        "4": {
          "name": "keyword.operator.optional.glugent"
        },
        "5": {
          "name": "keyword.operator.optional.glugent"
        },
        "6": {
          "name": "punctuation.definition.template-expression.end.glugent"
        }
      }
    },
    "optional-default": {
      "begin": "(\\{)\\s*([A-Za-z_][\\w.]*)\\s*(\\?)\\s*(\")",
      "end": "(\")\\s*(\\})",
      "name": "meta.template.optional.glugent",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.template-expression.begin.glugent"
        },
        "2": {
          "name": "variable.other.constant.optional.glugent"
        },
        "3": {
          "name": "keyword.operator.optional.glugent"
        },
        "4": {
          "name": "punctuation.definition.string.begin.glugent"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.glugent"
        },
        "2": {
          "name": "punctuation.definition.template-expression.end.glugent"
        }
      },
      "contentName": "string.quoted.double.default.glugent",
      "patterns": [
        {
          "match": "\\\\[\\s\\S]",
          "name": "constant.character.escape.glugent"
        }
      ]
    }
  }
}
