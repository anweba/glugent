{
  "name": "glugent-vscode",
  "private": true,
  "displayName": "Glugent",
  "description": "Syntax highlighting, diagnostics, completion and build commands for Glugent sections and targets.",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anweba/glugent.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/anweba/glugent#readme",
  "bugs": {
    "url": "https://github.com/anweba/glugent/issues"
  },
  "publisher": "glugent",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/glugent.config.json"
  ],
  "contributes": {
    "languages": [
      {
        "id": "glugent",
        "aliases": [
          "Glugent"
        ],
        "extensions": [
          ".ggen.md"
        ],
        "filenamePatterns": [
          "*.ggen.md"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "glugent",
        "scopeName": "source.glugent",
        "path": "./syntaxes/glugent.tmLanguage.json",
        "tokenTypes": {
          "markup.raw.glugent": "string",
          "meta.literal-brace.glugent": "string"
        },
        "unbalancedBracketScopes": [
          "markup.raw.glugent",
          "meta.literal-brace.glugent"
        ]
      },
      {
        "scopeName": "glugent.injection",
        "path": "./syntaxes/glugent-injection.tmLanguage.json",
        "injectTo": [
          "source.glugent"
        ]
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "glugent.config.json"
        ],
        "url": "./schemas/glugent-config.schema.json"
      },
      {
        "fileMatch": [
          "*.target.ggen.json",
          "*.agent.ggen.json",
          "*.doc.ggen.json"
        ],
        "url": "./schemas/target.schema.json"
      }
    ],
    "commands": [
      {
        "command": "glugent.buildAll",
        "title": "Glugent: Build All Targets"
      },
      {
        "command": "glugent.buildTarget",
        "title": "Glugent: Build Target..."
      },
      {
        "command": "glugent.validate",
        "title": "Glugent: Validate Project"
      }
    ]
  },
  "scripts": {
    "copy-schemas": "node -e \"const fs=require('fs');fs.mkdirSync('schemas',{recursive:true});for(const f of ['glugent-config','target'])fs.copyFileSync('../schemas/'+f+'.schema.json','schemas/'+f+'.schema.json')\"",
    "build": "npm run copy-schemas && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
    "package": "npm run build && vsce package --no-dependencies",
    "test": "node -e \"require('fs').rmSync('out-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --require ./out-test/test/setup.js --test out-test/test/*.test.js"
  },
  "devDependencies": {
    "@anweba/glugent-core": "0.3.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0"
  }
}
