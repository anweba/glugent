{
  "name": "glugent",
  "version": "0.4.1",
  "description": "Glue Markdown sections into AI agents, docs and other targets: the Glugent command line.",
  "keywords": [
    "glugent",
    "markdown",
    "templates",
    "ai-agents",
    "prompts",
    "agent-instructions",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anweba/glugent.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/anweba/glugent#readme",
  "bugs": {
    "url": "https://github.com/anweba/glugent/issues"
  },
  "bin": {
    "glugent": "bin/glugent.js"
  },
  "main": "dist/cli.js",
  "files": [
    "bin",
    "dist",
    "!dist/test"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p .",
    "test": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@anweba/glugent-core": "0.4.1"
  }
}
