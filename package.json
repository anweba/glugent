{
  "name": "glugent-monorepo",
  "private": true,
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anweba/glugent.git"
  },
  "homepage": "https://github.com/anweba/glugent#readme",
  "bugs": {
    "url": "https://github.com/anweba/glugent/issues"
  },
  "workspaces": [
    "packages/schemas",
    "packages/core",
    "packages/cli",
    "packages/vscode"
  ],
  "scripts": {
    "build": "npm run build -w @anweba/glugent-core && npm run build -w @anweba/glugent-cli && npm run build -w glugent-vscode",
    "test": "npm run build -w @anweba/glugent-core && npm run build -w @anweba/glugent-cli && npm test -w @anweba/glugent-core -w @anweba/glugent-cli -w glugent-vscode",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only",
    "release": "changeset tag",
    "example:validate": "node packages/cli/bin/glugent.js validate -c examples/basic/glugent.config.json",
    "example:build": "node packages/cli/bin/glugent.js build -c examples/basic/glugent.config.json"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^20.0.0",
    "typescript": "6.0.3"
  }
}
